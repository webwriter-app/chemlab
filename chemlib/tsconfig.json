{
  "compilerOptions": {
    "outDir": "lib",
    "lib": ["ES2017", "DOM"],
    "declaration": true,
    "sourceMap": true,
    "module": "es6",
    "target": "es5",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "esModuleInterop": false,
    "allowJs": true,
    "moduleResolution": "node"
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "lib-esm"]
}
